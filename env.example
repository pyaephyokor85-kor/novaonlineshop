# Public: bundled into the app. Never put service-role, AI or Telegram secrets here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Local web: http://localhost:8787. Phone: your computer's LAN IP, not localhost.
# Vercel web deployment: leave blank to use same-origin /api routes.
EXPO_PUBLIC_API_URL=

# Server-only: set locally or in your hosting provider's environment settings.
PORT=8787
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: without an AI key the advisor uses catalog-based recommendations.
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-5-mini

# Optional server cloud-profile endpoints (the app uses the public Supabase settings).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Thermer: server-only, Preview branch only; never enable in Production.
# Requires explicit existing Preview Supabase URL and service-role configuration.
NOVA_THERMER_PRINT_ENABLED=false
NOVA_PRINT_TOKEN_SECRET=
NOVA_THERMER_RELAY_URL=
# Printing is additionally restricted in code to the existing fake QA receipt.
